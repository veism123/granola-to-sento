# Your Sento workspace's MCP address (from the console's install guide)
# and the courier connection key you minted there. The connection needs
# read and write granted on your meeting transcripts entity.
SENTO_MCP_URL=https://app.yourcompany-sento.com/api/mcp
SENTO_COURIER_KEY=...

# Granola API key, minted in the Granola desktop app (Settings > API keys,
# Business plan). It can read every transcript in your Granola workspace:
# treat it like a password.
GRANOLA_API_KEY=grn_...

# How often to check for new meetings, in minutes.
POLL_MINUTES=60

# Practice mode: logs what WOULD be written, writes nothing. Read one
# cycle's log, then set to false.
DRY_RUN=true
